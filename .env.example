# ============================================================================
#  MULYA BAKERY — CONTOH ENVIRONMENT VARIABLE
# ----------------------------------------------------------------------------
#  Salin file ini menjadi `.env` lalu isi nilainya:
#      cp .env.example .env
#
#  PENTING: `.env` TIDAK BOLEH ikut ter-commit ke Git.
#  Pastikan baris `.env` sudah ada di .gitignore.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Ambil dari: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxx.supabase.co

# Gunakan kunci "anon" / "public" / "publishable" — BUKAN "service_role".
# Kunci anon memang ikut terkirim ke browser; itu normal. Yang menjaga data
# adalah Row Level Security di database.
#
# Kunci service_role / sb_secret_ melewati SELURUH Row Level Security. Kalau
# kunci itu sampai masuk ke sini, seluruh nama, nomor HP, dan alamat pelanggan
# bisa dibaca siapa pun yang membuka DevTools. Jangan pernah.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# ── Nomor WhatsApp tujuan pesanan ───────────────────────────────────────────
# Format internasional tanpa tanda "+" dan tanpa spasi.
# Indonesia: 62 + nomor tanpa angka 0 di depan.
# Contoh: 081234567890  ->  6281234567890
#
# JANGAN dibiarkan berisi nomor contoh. Kalau situs ini live dengan nomor
# yang salah, seluruh data pelanggan (nama, HP, alamat rumah) terkirim ke
# nomor orang asing.
VITE_WHATSAPP_NUMBER=628xxxxxxxxxx

# Nomor WhatsApp alternatif (kedua) yang ditampilkan di bagian kontak.
# Format sama: 62 + nomor tanpa angka 0 di depan. BERSIFAT OPSIONAL — bila
# dikosongkan, nomor kedua otomatis disembunyikan dari halaman.
# Contoh: +62 831-4839-1567  ->  6283148391567
VITE_WHATSAPP_NUMBER2=

# ── Super Admin (Feature Gating) ─────────────────────────────────────────────
# Email yang boleh membuka tab "Pengaturan Fitur" di panel admin (/admin).
# Login tetap lewat halaman admin biasa; setelah login, email yang terdaftar
# di sini otomatis diarahkan ke dashboard super admin.
# Pisahkan dengan koma bila lebih dari satu. Contoh:
#     VITE_SUPER_ADMIN_EMAILS=owner@example.com,mitra@example.com
VITE_SUPER_ADMIN_EMAILS=